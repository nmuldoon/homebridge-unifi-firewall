{
  "displayName": "Homebridge Unifi Firewall Switch",
  "name": "homebridge-unifi-firewall",
  "version": "1.3.0",
  "description": "Toggle a UniFi Network 9 firewall policy on/off via Homebridge/HomeKit (based on jak's homebridge-unifi-firewall)",
  "license": "Apache License 2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/nmuldoon/homebridge-unifi-firewall.git"
  },
  "bugs": {
    "url": "https://github.com/nmuldoon/homebridge-unifi-firewall/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "homebridge": ">=1.3.5"
  },
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "watch": "npm run build && npm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "npm run lint && npm run build",
    "prepare": "husky",
    "discover-rules": "npm run build && node dist/discover-rules.js",
    "test-policy-toggle": "npm run build && node dist/test-policy-toggle.js"
  },
  "keywords": [
    "homebridge-plugin",
    "unifi",
    "ubiquiti",
    "usg",
    "usg-unifi"
  ],
  "dependencies": {
    "unifi-client": "^0.11.1"
  },
  "devDependencies": {
    "@types/debug": "^4.1.13",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "homebridge": "^1.3.9",
    "husky": "^9.0.0",
    "lint-staged": "^17.0.0",
    "nodemon": "^3.1.9",
    "prettier": "^3.0.0",
    "rimraf": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "lint-staged": {
    "**/*": "prettier --write --ignore-unknown"
  }
}
